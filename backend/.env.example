# App Environment
PORT=
NODE_ENV=
FRONTEND_URL=
API_PREFIX=
TRUSTED_PROXIES=

# Database Configuration (PostgreSQL/Prisma)
DATABASE_URL=

# AWS Configuration (S3 for assets)
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Auth & Sessions
JWT_SECRET=
SESSION_SECRET=
# Optional; leave empty for cross-origin Vercel↔Render (Domain is not set on cookies).
COOKIE_DOMAIN=

# Cloudflare Turnstile (Bot protection)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=

# Security Configuration
# Production MUST list the Vercel origin (comma-separated). Avoid "*" with credentialed cookies.
# Example: CORS_ORIGIN=https://hillary-step.vercel.app
CORS_ORIGIN=
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
